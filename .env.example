# Copy to .env.local (never commit real values). All optional — the site degrades gracefully.

# Contact form (Resend) — server only. Without a key the form shows "email me directly".
RESEND_API_KEY=
CONTACT_TO_EMAIL=chetanpujari92@gmail.com
# Verified Resend sender, e.g. "Chetan Pujari <hello@chetanpujari.com>" (defaults to onboarding@resend.dev)
CONTACT_FROM_EMAIL=

# Optional "Ask Chetan" app. The key is server only; the flag shows the app.
NEXT_PUBLIC_ENABLE_ASK=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional GitHub heatmap via GraphQL (server only; a fine-grained token with no permissions).
# Without it the widget parses the public contributions page.
GITHUB_TOKEN=

# Canonical URL for SEO/OG (defaults to Vercel's production URL, then https://chetanpujari.com)
NEXT_PUBLIC_SITE_URL=
