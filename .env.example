# Copy to .env.local (never commit real values). All optional — the site degrades gracefully.

# Contact form email, server only. Steps: README → "Contact form email".
# Gmail SMTP: your Gmail address and a Google app password (16 letters; spaces are fine).
# Without these (and without RESEND_API_KEY) the form can't send and offers "email me directly".
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where messages go. Unset = `email` in content/profile.ts. Replies go to the visitor (Reply-To).
CONTACT_TO_EMAIL=
# Optional fallback, used only when RESEND_API_KEY is set and neither Gmail variable is.
RESEND_API_KEY=
# Resend sender on a verified domain, e.g. "Chetan Pujari <hello@chetanpujari.com>". Unset = the test
# sender onboarding@resend.dev, which ONLY delivers to the Resend account owner's own address.
CONTACT_FROM_EMAIL=

# Optional "Ask Chetan" app. The key is server only; the flag shows the app.
NEXT_PUBLIC_ENABLE_ASK=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional GitHub heatmap via GraphQL (server only; a fine-grained token with no permissions).
# Without it the widget parses the public contributions page.
GITHUB_TOKEN=

# App tile faces: unset/`ios18` = iOS 18 App Icons pack (CC BY 4.0, public/icons/ios18/LICENSE.txt);
# `original` = the site's own gradient-and-glyph set.
NEXT_PUBLIC_ICON_PACK=

# 3D phone back: `true` shows the model's own (manufacturer) logo. Leave unset until the model's
# licence is confirmed to allow it; the ⚡ CP mark is shown instead.
NEXT_PUBLIC_SHOW_MODEL_LOGO=

# Canonical URL for SEO/OG (defaults to Vercel's production URL, then https://chetanpujari.com)
NEXT_PUBLIC_SITE_URL=
