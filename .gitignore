# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example
/test-results
/playwright-report
/docs/reference
/docs/feel/videos
/docs/feel/frames
/docs/feel/ref
docs/v4/**/*.webm

# v5 device-matrix shots: hundreds of MB, regenerated by `node scripts/fit-shots.mjs`; only the contact sheets are committed
/docs/v5/fit/*.png
/docs/v5/fit/*.html
# raw Chrome traces (tens of MB)
/docs/v5/speed/*.json
!/docs/v5/speed/trace-summary*.json
# Built by scripts/build-sw.mjs before next build
/public/sw.js

# Raw iPhone 18 Pro Max model export (licence unconfirmed; the optimized copy ships from public/models)
/apple-iphone-18-pro-max-burgundy-2026/
# Original guide prompts: contain private data (see guide repo notes)
/guide-sources/
